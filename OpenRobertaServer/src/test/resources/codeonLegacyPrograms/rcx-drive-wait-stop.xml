<block_set xmlns="http://de.fhg.iais.roberta.blockly" robottype="rcx" xmlversion="3.1" description="CodeON LEGACY regression: RCX drive, wait, stop" tags="">
    <instance x="50" y="50">
        <block type="robControls_start" id="rcx-start" intask="true" deletable="false">
            <mutation declare="false"/>
            <field name="DEBUG">TRUE</field>
        </block>
        <block type="robActions_motorDiff_on" id="rcx-drive" intask="true">
            <field name="DIRECTION">FOREWARD</field>
            <value name="POWER">
                <block type="math_number" id="rcx-power" intask="true">
                    <field name="NUM">30</field>
                </block>
            </value>
        </block>
        <block type="robControls_wait_time" id="rcx-wait" intask="true">
            <value name="WAIT">
                <block type="math_number" id="rcx-duration" intask="true">
                    <field name="NUM">250</field>
                </block>
            </value>
        </block>
        <block type="robActions_motorDiff_stop" id="rcx-stop" intask="true"/>
    </instance>
</block_set>
