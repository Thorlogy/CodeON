<block_set xmlns="http://de.fhg.iais.roberta.blockly" robottype="apitor" xmlversion="3.1" description="CodeON LEGACY regression: Apitor motor and stop" tags="">
    <instance x="50" y="50">
        <block type="robControls_start" id="apitor-start" intask="true" deletable="false">
            <mutation declare="false"/>
            <field name="DEBUG">TRUE</field>
        </block>
        <block type="apitorActions_motor" id="apitor-motor" intask="true">
            <field name="PORT">M1</field>
            <field name="DIRECTION">FORWARD</field>
            <field name="SPEED">6</field>
        </block>
        <block type="robControls_wait_time" id="apitor-wait" intask="true">
            <value name="WAIT">
                <block type="math_number" id="apitor-duration" intask="true">
                    <field name="NUM">250</field>
                </block>
            </value>
        </block>
        <block type="apitorActions_stopMotor" id="apitor-stop" intask="true">
            <field name="PORT">M1</field>
        </block>
    </instance>
</block_set>
