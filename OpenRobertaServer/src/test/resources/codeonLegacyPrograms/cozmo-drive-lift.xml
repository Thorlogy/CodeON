<block_set xmlns="http://de.fhg.iais.roberta.blockly" robottype="cozmo" xmlversion="3.1" description="CodeON LEGACY regression: Cozmo drive and lift" tags="">
    <instance x="50" y="50">
        <block type="robControls_start" id="cozmo-start" intask="true" deletable="false">
            <mutation declare="false"/>
            <field name="DEBUG">TRUE</field>
        </block>
        <block type="actions_motorDiff_on_for" id="cozmo-drive" intask="true">
            <field name="DIRECTION">FOREWARD</field>
            <value name="POWER">
                <block type="math_number" id="cozmo-power" intask="true">
                    <field name="NUM">30</field>
                </block>
            </value>
            <value name="DISTANCE">
                <block type="math_number" id="cozmo-distance" intask="true">
                    <field name="NUM">10</field>
                </block>
            </value>
        </block>
        <block type="cozmoActions_lift" id="cozmo-lift" intask="true">
            <field name="MODE">UP</field>
        </block>
    </instance>
</block_set>
