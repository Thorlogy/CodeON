<block_set xmlns="http://de.fhg.iais.roberta.blockly" robottype="rcj" xmlversion="3.1" description="CodeON LEGACY regression: RCJ drive and display" tags="">
    <instance x="50" y="50">
        <block type="robControls_start" id="rcj-start" intask="true" deletable="false">
            <mutation declare="false"/>
            <field name="DEBUG">TRUE</field>
        </block>
        <block type="actions_motorDiff_on_for" id="rcj-drive" intask="true">
            <field name="DIRECTION">FOREWARD</field>
            <hide name="ACTORPORT" value="_D"/>
            <value name="POWER">
                <block type="math_number" id="rcj-power" intask="true">
                    <field name="NUM">30</field>
                </block>
            </value>
            <value name="DISTANCE">
                <block type="math_number" id="rcj-distance" intask="true">
                    <field name="NUM">10</field>
                </block>
            </value>
        </block>
        <block type="actions_display_text_rcj" id="rcj-display" intask="true">
            <field name="ACTORPORT">_B</field>
            <hide name="ACTORPORT" value="_B"/>
            <value name="TEXT">
                <block type="text" id="rcj-text" intask="true">
                    <field name="TEXT">CodeON</field>
                </block>
            </value>
            <value name="ROW">
                <block type="math_number" id="rcj-row" intask="true">
                    <field name="NUM">0</field>
                </block>
            </value>
        </block>
    </instance>
</block_set>
