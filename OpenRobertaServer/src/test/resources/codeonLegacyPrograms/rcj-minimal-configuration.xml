<block_set xmlns="http://de.fhg.iais.roberta.blockly" robottype="rcj" xmlversion="" description="Minimal configuration for the CodeON LEGACY regression" tags="">
    <instance x="100" y="50">
        <block type="robConf_differentialdrive" id="rcj-drive-config" intask="true">
            <field name="NAME">_D</field>
            <field name="BRICK_WHEEL_DIAMETER">5.6</field>
            <field name="BRICK_TRACK_WIDTH">14</field>
            <field name="MOTOR_L">A</field>
            <field name="MOTOR_R">B</field>
        </block>
    </instance>
    <instance x="100" y="300">
        <block type="robConf_motor" id="rcj-left-motor-config" intask="true">
            <field name="NAME">MA</field>
            <field name="PORT">A</field>
        </block>
    </instance>
    <instance x="300" y="300">
        <block type="robConf_motor" id="rcj-right-motor-config" intask="true">
            <field name="NAME">MB</field>
            <field name="PORT">B</field>
        </block>
    </instance>
</block_set>
