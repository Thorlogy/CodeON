<block_set xmlns="http://de.fhg.iais.roberta.blockly" robottype="rcj" xmlversion="3.1" description="CodeON LEGACY regression: RCJ drive and wait" tags="">
    <instance x="50" y="50">
        <block type="robControls_start" id="rcj-start" intask="true" deletable="false">
            <mutation declare="false"/>
            <field name="DEBUG">TRUE</field>
        </block>
        <block type="actions_motorDiff_on_for" id="rcj-drive" intask="true">
            <field name="DIRECTION">FOREWARD</field>
            <hide name="ACTORPORT" value="_D"/>
            <value name="POWER">
                <block type="math_number" id="rcj-power" intask="true">
                    <field name="NUM">30</field>
                </block>
            </value>
            <value name="DISTANCE">
                <block type="math_number" id="rcj-distance" intask="true">
                    <field name="NUM">10</field>
                </block>
            </value>
        </block>
        <block type="robControls_wait_time" id="rcj-wait" intask="true">
            <value name="WAIT">
                <block type="math_number" id="rcj-wait-time" intask="true">
                    <field name="NUM">250</field>
                </block>
            </value>
        </block>
    </instance>
</block_set>
